# ---------------------------------------------------------------------------
# MedDevAudit-IN environment configuration
#
# Copy this file to `.env` in the project root and fill in the values you want.
# EVERY value here is optional — the app runs end-to-end with no .env file at
# all, using the deterministic keyword/regex matcher instead of the LLM.
# ---------------------------------------------------------------------------

# Anthropic API key. When set, clause verification is performed by Claude with
# a grounded, per-clause prompt returning strict JSON. When unset (or when the
# API call fails), the app transparently falls back to the built-in
# deterministic matcher, and each finding is labelled with which engine ran.
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for clause verification. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# How many clauses to verify in parallel against the API (1-10). Default 4.
AI_CONCURRENCY=4

# Port the Express API listens on. The Vite dev server proxies /api here.
# Hosting platforms inject PORT instead; PORT takes precedence when present.
API_PORT=4000

# Weight of the sentence-embedding score in the hybrid retriever (0..1).
# 0.65 is the empirical optimum from Rayo et al., COLING 2025 (Paper 7).
HYBRID_ALPHA=0.65

# Maximum audit runs per IP per minute on the public endpoint.
AUDIT_RATE_LIMIT=20

# Production only: comma-separated origins allowed to call the API cross-origin.
# Not needed when the API serves the frontend itself (the default deployment).
# CORS_ORIGIN=https://example.com

# Where the embedding model is cached (default: <repo>/.model-cache).
# MODEL_CACHE_DIR=
