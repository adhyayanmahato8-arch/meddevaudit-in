{
  "name": "meddevaudit-in",
  "version": "1.0.0",
  "private": true,
  "description": "AI compliance auditor for imported medical device dossiers under India's Medical Device Rules, 2017",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run setup && concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @meddevaudit/api",
    "dev:web": "npm run dev -w @meddevaudit/web",
    "db:reset": "node scripts/setup.mjs --reset",
    "db:studio": "npm run studio -w @meddevaudit/db",
    "build": "npm run build -w @meddevaudit/web",
    "fixtures:build": "npm run build-fixtures -w @meddevaudit/eval",
    "eval": "npm run eval -w @meddevaudit/eval --",
    "test:llm-contract": "npm run test:llm-contract -w @meddevaudit/api",
    "start": "node scripts/setup.mjs && npm run start -w @meddevaudit/api",
    "typecheck": "npm run typecheck -w @meddevaudit/api && tsc --noEmit -p apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
